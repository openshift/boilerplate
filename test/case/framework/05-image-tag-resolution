#!/usr/bin/env bash

set -e

cat <<EOF
Tests that boilerplate/update defaults consuming repositories to the latest
boilerplate image tag and migrates existing image-v* metadata.
EOF

REPO_ROOT=$(git rev-parse --show-toplevel)

source "$REPO_ROOT/test/lib.sh"

# Exercise the default rather than the test suite's pinned value.
unset LATEST_IMAGE_TAG

# A registry lookup is no longer needed when updating a consuming repository.
stubdir=$(mktemp -d -t boilerplate-skopeo-XXXXXXXX)
add_cleanup "$stubdir"
export SKOPEO_CALLED="$stubdir/called"
cat <<'EOF' > "$stubdir/skopeo"
#!/usr/bin/env bash

touch "$SKOPEO_CALLED"
echo "skopeo should not be called while resolving the default image tag" >&2
exit 1
EOF
chmod +x "$stubdir/skopeo"
export PATH="$stubdir:$PATH"

# Use a local boilerplate repository so this case remains useful when run
# against an uncommitted working tree.
bp_clone=$(mktemp -d -t boilerplate-image-tags-XXXXXXXX)
add_cleanup "$bp_clone"
git clone -q "$REPO_ROOT" "$bp_clone"
git -C "$bp_clone" config user.name "Boilerplate Image Tag Test"
git -C "$bp_clone" config user.email "boilerplate-image-tag-test@example.com"
cp "$REPO_ROOT/boilerplate/update" "$bp_clone/boilerplate/update"
git -C "$bp_clone" add boilerplate/update
if ! git -C "$bp_clone" diff --cached --quiet; then
    git -C "$bp_clone" commit -q -m "Use working tree update script for test"
fi
git -C "$bp_clone" tag image-v99.0.0
export BOILERPLATE_GIT_REPO="$bp_clone"

assert_backing_tag() {
    local expected=$1
    local repo
    local actual

    repo=$(empty_repo)
    add_cleanup "$repo"
    bootstrap_repo "$repo"
    mkdir -p "$repo/boilerplate/_data"
    printf '%s\n' image-v8.4.4 > "$repo/boilerplate/_data/backing-image-tag"
    (
        cd "$repo"
        make --no-print-directory boilerplate-update >/dev/null
        actual=$(cat boilerplate/_data/backing-image-tag)
        [[ "$actual" == "$expected" ]] || err "Expected backing-image-tag '$expected', got '$actual'"
    )
}

echo "== Migrate an existing backing-image tag"
assert_backing_tag latest
[[ ! -e "$SKOPEO_CALLED" ]] || err "Unexpected registry lookup while resolving latest"

echo "== Respect an explicit tag override"
(
    export LATEST_IMAGE_TAG=image-v99.0.0
    assert_backing_tag image-v99.0.0
)

echo "== Regenerate .ci-operator.yaml with the latest tag"
repo=$(empty_repo)
add_cleanup "$repo"
bootstrap_repo "$repo"
add_convention "$repo" openshift/osd-container-image
(
    cd "$repo"
    make --no-print-directory boilerplate-update >/dev/null
    actual=$(${SED?} -n 's/^  tag: //p' .ci-operator.yaml)
    [[ "$actual" == latest ]] || err "Expected .ci-operator.yaml tag 'latest', got '$actual'"
)

echo "All image tag migration checks passed."
