#!/usr/bin/env bash

set -e

cat <<EOF
Tests updating from a local boilerplate baseline to the current files, and
then reverting to the baseline.
EOF

HERE=${0%/*}

REPO_ROOT=$(git rev-parse --show-toplevel)
current_commit=$(git -C "$REPO_ROOT" rev-parse HEAD)

source $REPO_ROOT/test/lib.sh

# Hack: some checks will fail if master is at an earlier tag. Other
# tests validate the proper setting of this variable.
export SKIP_IMAGE_TAG_CHECK=1

repo=$(empty_repo)
add_cleanup $repo

bootstrap_repo $repo

cd $repo

boilerplate_master=$(mktemp -d -t boilerplate-master-XXXXXXXX)
add_cleanup "$boilerplate_master"
git clone -q "$REPO_ROOT" "$boilerplate_master"
git -C "$boilerplate_master" config user.name "Boilerplate Update Test"
git -C "$boilerplate_master" config user.email "boilerplate-update-test@example.com"
git -C "$boilerplate_master" fetch -q "$REPO_ROOT" "$current_commit"
git -C "$boilerplate_master" checkout -q -b boilerplate-test-current FETCH_HEAD
git -C "$boilerplate_master" checkout -q -b boilerplate-test-master
echo "baseline-only test fixture" > "$boilerplate_master/boilerplate/test/test-base-convention/master-only.txt"
git -C "$boilerplate_master" add boilerplate/test/test-base-convention/master-only.txt
git -C "$boilerplate_master" commit -q -m "Create local baseline for update test"

override_boilerplate_repo $boilerplate_master || exit $?

add_convention $repo test/test-base-convention
make boilerplate-update || exit $?
check_update $repo 04-check-after-init || exit $?
# So the next update starts "clean"
./boilerplate/_lib/boilerplate-commit

git -C "$boilerplate_master" checkout -q boilerplate-test-current
override_boilerplate_repo $boilerplate_master || exit $?

make boilerplate-update || exit $?
check_update $repo 04-check-new-version-update || exit $?
# So the next update starts "clean"
./boilerplate/_lib/boilerplate-commit

git -C "$boilerplate_master" checkout -q boilerplate-test-master
override_boilerplate_repo $boilerplate_master || exit $?

make boilerplate-update || exit $?
check_update $repo 04-check-new-version-update || exit $?
