#!/usr/bin/env bash

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
# shellcheck disable=SC1091
source "${REPO_ROOT}/test/lib.sh"

toolchain_version="$(go version)"
target_os="$(go env GOOS)"
repo="$(empty_repo)"
add_cleanup "${repo}"
cd "${repo}"

cat > go.mod <<'EOF'
module example.com/native-fips-test

go 1.24.0
EOF

cat > main.go <<'EOF'
package main

import "fmt"

func main() {
	fmt.Println("FIPS mode successfully verified. Running safely...")
}
EOF

cat > Makefile <<EOF
IMAGE_REGISTRY := example.com
IMAGE_REPOSITORY := example
IMAGE_NAME := native-fips-test
VERSION_MAJOR := 0
VERSION_MINOR := 1
OPERATOR_NAME := native-fips-test
include ${REPO_ROOT}/boilerplate/openshift/golang-osd-operator/standard.mk
EOF

mkdir -p boilerplate/openshift/golang-osd-operator build/_output/bin
ln -s "${REPO_ROOT}/boilerplate/openshift/golang-osd-operator/configure-fips.sh" boilerplate/openshift/golang-osd-operator/configure-fips.sh
ln -s "${REPO_ROOT}/boilerplate/openshift/golang-osd-operator/fips.go.tmplt" boilerplate/openshift/golang-osd-operator/fips.go.tmplt
git add go.mod main.go Makefile
git commit -m "Add minimal Go build fixture" >/dev/null

unset FIPS_ENABLED GOFIPS140 GOFLAGS_MOD

enabled_command="$(FIPS_ENABLED=true make --no-print-directory --dry-run go-build)"
if ! grep -q 'GOFIPS140=v1.0.0' <<< "${enabled_command}"; then
    err "FIPS-enabled go-build did not select GOFIPS140=v1.0.0"
fi
if grep -Eq 'GOEXPERIMENT=boringcrypto|GOFIPS140=off' <<< "${enabled_command}"; then
    err "FIPS-enabled go-build still injects a legacy BoringCrypto setting"
fi
if ! grep -q 'fips_enabled' <<< "${enabled_command}"; then
    err "FIPS-enabled go-build did not preserve the fips_enabled build tag"
fi
if ! grep -q 'configure-fips.sh' <<< "${enabled_command}"; then
    err "FIPS-enabled go-build did not generate the startup assertion file"
fi
custom_tags_command="$(GOFLAGS_MOD='-mod=vendor -tags=custom' FIPS_ENABLED=true make --no-print-directory --dry-run go-build)"
if ! grep -Eq 'GOFLAGS="-mod=vendor -tags=fips_enabled(,no_openssl)?,custom"' <<< "${custom_tags_command}"; then
    err "FIPS build flags did not preserve consumer Go build flags: ${custom_tags_command}"
fi
if [[ "${toolchain_version}" == *"(Red Hat "* ]]; then
    if ! grep -q 'no_openssl' <<< "${enabled_command}"; then
        err "FIPS-enabled Red Hat Go builds must select the native Go crypto backend"
    fi
elif grep -q 'no_openssl' <<< "${enabled_command}"; then
    err "The Red Hat-specific no_openssl tag was unexpectedly added for this toolchain"
fi

linux_command="$(FIPS_ENABLED=true make --no-print-directory --dry-run go-build GOOS=linux)"
if ! grep -Fq -- '-ldflags="-linkmode=external"' <<< "${linux_command}"; then
    err "FIPS-enabled Linux builds did not select external linking: ${linux_command}"
fi
if ! grep -Fq 'CGO_ENABLED=1' <<< "${linux_command}"; then
    err "FIPS-enabled Linux builds did not retain CGO_ENABLED=1"
fi
if ! grep -Fq 'readelf -lW' <<< "${linux_command}"; then
    err "FIPS-enabled Linux builds did not verify the ELF interpreter"
fi
non_linux_command="$(FIPS_ENABLED=true make --no-print-directory --dry-run go-build GOOS=darwin)"
if grep -Eq 'linkmode=external|readelf' <<< "${non_linux_command}"; then
    err "FIPS-enabled non-Linux builds unexpectedly received Linux linking settings"
fi

false_command="$(FIPS_ENABLED=false make --no-print-directory --dry-run go-build GOOS=linux)"
if grep -Eq 'GOFIPS140=|no_openssl|fips_enabled|configure-fips.sh|linkmode=external|readelf' <<< "${false_command}"; then
    err "FIPS_ENABLED=false unexpectedly injects native FIPS build settings"
fi

unset FIPS_ENABLED
unset_command="$(make --no-print-directory --dry-run go-build GOOS=linux)"
if grep -Eq 'GOFIPS140=|no_openssl|fips_enabled|configure-fips.sh|linkmode=external|readelf' <<< "${unset_command}"; then
    err "An unset FIPS_ENABLED unexpectedly injects native FIPS build settings"
fi

FIPS_ENABLED=true make --no-print-directory go-build
enabled_binary="build/_output/bin/native-fips-test"
if [[ "${target_os}" == linux ]]; then
    if ! readelf -lW "${enabled_binary}" | grep -E '^[[:space:]]*INTERP[[:space:]]' >/dev/null; then
        err "FIPS-enabled Linux binary has no ELF interpreter"
    fi
    if ! readelf -dW "${enabled_binary}" | grep -F '(NEEDED)' >/dev/null; then
        err "FIPS-enabled Linux binary has no shared-library dependencies"
    fi
    # Overriding the build flags can bypass external linking, but a static
    # executable must still be rejected by the post-build ELF check.
    if FIPS_ENABLED=true make --no-print-directory go-build OPERATOR_NAME=native-fips-static \
        GOBUILDFLAGS='-ldflags=-linkmode=internal' >static-build.log 2>&1; then
        err "FIPS-enabled Linux build accepted a statically linked executable"
    fi
    if ! grep -Fq '[ERROR] FIPS-enabled Linux binary must be dynamically linked' static-build.log; then
        err "The static build failed for an unexpected reason: $(<static-build.log)"
    fi
fi
if [[ ! -f fips.go ]] || ! grep -q 'crypto/fips140' fips.go || ! grep -q '^//go:debug fips140=on$' fips.go; then
    err "FIPS-enabled go-build did not generate the native FIPS assertion and default"
fi
cat > fips.go <<'EOF'
//go:build boilerplate_fips_assertion
// +build boilerplate_fips_assertion

// BOILERPLATE GENERATED -- DO NOT EDIT
// Run 'make ensure-fips' to regenerate

package main

import "crypto/fips140"

func init() {
	// Assert that FIPS mode is enabled via GODEBUG=fips140=on (or =only)
	if !fips140.Enabled() {
		panic("CRITICAL: Application startup aborted. FIPS 140 mode is NOT enabled!")
	}
}
EOF
FIPS_ENABLED=true make --no-print-directory ensure-fips >/dev/null
if ! grep -q 'fips_enabled' fips.go || grep -q 'boilerplate_fips_assertion' fips.go || ! grep -q '^//go:debug fips140=on$' fips.go; then
    err "ensure-fips did not migrate the previous assertion tag and embed the FIPS default"
fi
cat > fips.go <<'EOF'
//go:build fips_enabled
// +build fips_enabled

// BOILERPLATE GENERATED -- DO NOT EDIT
// Run 'make ensure-fips' to regenerate

package main

import "crypto/fips140"

func init() {
	// Assert that FIPS mode is enabled via GODEBUG=fips140=on (or =only)
	if !fips140.Enabled() {
		panic("CRITICAL: Application startup aborted. FIPS 140 mode is NOT enabled!")
	}
}
EOF
FIPS_ENABLED=true make --no-print-directory ensure-fips >/dev/null
if ! grep -q '^//go:debug fips140=on$' fips.go; then
    err "ensure-fips did not migrate a fips_enabled template missing the runtime default"
fi
cp fips.go fips.go.original
printf '\n// consumer customization\n' >>fips.go
if FIPS_ENABLED=true make --no-print-directory ensure-fips >/dev/null 2>&1; then
    mv fips.go.original fips.go
    err "ensure-fips overwrote a customized fips.go"
fi
if ! grep -q 'consumer customization' fips.go; then
    err "ensure-fips modified a customized fips.go"
fi
mv fips.go.original fips.go
enabled_info="$(go version -m "${enabled_binary}")"
if ! grep -Eq 'GOFIPS140=v1\.0\.0([^[:space:]]*)' <<< "${enabled_info}"; then
    err "FIPS-enabled binary does not report module v1.0.0 (or a resolved snapshot): ${enabled_info}"
fi
if ! grep -E 'DefaultGODEBUG=' <<< "${enabled_info}" | grep -Eq '(^|[=,])fips140=on([,[:space:]]|$)'; then
    err "FIPS-enabled binary does not embed fips140=on as its default: ${enabled_info}"
fi
if [[ "${toolchain_version}" == *"(Red Hat "* ]] && ! grep -q 'no_openssl' <<< "${enabled_info}"; then
    err "FIPS-enabled Red Hat binary did not select the native Go crypto backend: ${enabled_info}"
fi
if grep -Eqi 'boringcrypto' <<< "${enabled_info}"; then
    err "FIPS-enabled binary still reports the legacy BoringCrypto experiment: ${enabled_info}"
fi
if ! grep -q 'fips_enabled' <<< "${enabled_info}"; then
    err "FIPS-enabled binary does not include the fips_enabled tag: ${enabled_info}"
fi
if [[ "${target_os}" == linux ]] && ! grep -Fq -- '-linkmode=external' <<< "${enabled_info}"; then
    err "FIPS-enabled Linux binary does not report external linking: ${enabled_info}"
fi

default_status="$("./${enabled_binary}")"
if [[ "${default_status}" != "FIPS mode successfully verified. Running safely..." ]]; then
    err "The embedded FIPS default did not allow the application to start: ${default_status}"
fi
forced_on_status="$(GODEBUG=fips140=on "./${enabled_binary}")"
if [[ "${forced_on_status}" != "FIPS mode successfully verified. Running safely..." ]]; then
    err "The FIPS startup assertion did not allow the application to start in FIPS mode: ${forced_on_status}"
fi
if GODEBUG=fips140=off "./${enabled_binary}" >fips-off.log 2>&1; then
    err "The FIPS startup assertion allowed the application to start with FIPS mode disabled"
fi
if ! grep -Fq 'CRITICAL: Application startup aborted. FIPS 140 mode is NOT enabled!' fips-off.log; then
    err "The FIPS startup assertion failed for an unexpected reason: $(<fips-off.log)"
fi

assert_non_fips_binary() {
    local setting="$1"
    local info="$2"
    # Red Hat Go toolsets may report v1.0.0 as their implicit module snapshot;
    # FIPS_ENABLED must not inject the runtime mode or native-backend tag.
    if grep -Eq 'DefaultGODEBUG=.*fips140=(on|auto)|no_openssl|fips_enabled|linkmode=external' <<< "${info}"; then
        err "${setting} unexpectedly enabled native FIPS mode, the startup assertion, or external linking: ${info}"
    fi
}

FIPS_ENABLED=false make --no-print-directory go-build
false_info="$(go version -m "${enabled_binary}")"
assert_non_fips_binary "FIPS_ENABLED=false" "${false_info}"
if ! GODEBUG=fips140=off "./${enabled_binary}" >/dev/null 2>&1; then
    err "A non-FIPS build unexpectedly included the FIPS startup assertion"
fi

unset FIPS_ENABLED
make --no-print-directory go-build
unset_info="$(go version -m "${enabled_binary}")"
assert_non_fips_binary "unset FIPS_ENABLED" "${unset_info}"

colorprint "${GREEN}" "Native Go FIPS 140-3 tests passed!"
