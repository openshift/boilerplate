{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>konflux-ci/mintmaker//config/renovate/renovate.json",
    "config:best-practices",
    ":automergeDigest",
    "group:allDigest"
  ],
  "enabledManagers": [
    "dockerfile",
    "tekton",
    "gomod"
  ],
  "dockerfile": {
    "includePaths": [
      "config/Dockerfile"
    ],
    "packageRules": [
      {
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest"
        ],
        "automerge": false,
        "platformAutomerge": false,
        "addLabels": ["lgtm", "approved"]
      }
    ]
  },
  "tekton": {
    "includePaths": [
      "pipelines/**",
      ".tekton/**"
    ],
    "enabled": true,
    "packageRules": [
      {
        "description": "Tekton patch/minor; batch Mon-Fri 9am-5pm EST — pre-label lgtm/approved; Tide merges after Prow + Konflux",
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest"
        ],
        "automerge": false,
        "schedule": ["* 9-16 * * 1-5"],
        "platformAutomerge": false,
        "addLabels": ["lgtm", "approved"]
      },
      {
        "description": "Tekton major — open PR for manual /lgtm; never automerge",
        "matchUpdateTypes": [
          "major"
        ],
        "automerge": false,
        "addLabels": [
          "major-update",
          "manual-review-required",
          "area/dependency",
          "ok-to-test"
        ]
      }
    ]
  },
  "gomod": {
    "description": "Only propose updates compatible with the repo's own `go` directive: with constraintsFiltering strict, Renovate skips releases whose go.mod requires a newer Go than declared. Consumers can't raise Go until the shared boilerplate build/lint image does, so such updates can't merge (e.g. a dep that pulls the toolchain to go 1.27 while the image is 1.26). Requires Renovate >= 43.159.2 for correct minor-version matching (MintMaker's image ships 44.x).",
    "constraintsFiltering": "strict",
    "packageRules": [
      {
        "description": "Grouped gomod minor/patch; batch Mon-Fri 9am-5pm EST — pre-label lgtm/approved; Tide merges after Prow + Konflux",
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest"
        ],
        "groupName": "gomod dependencies",
        "schedule": ["* 9-16 * * 1-5"],
        "automerge": false,
        "platformAutomerge": false,
        "addLabels": ["lgtm", "approved"]
      },
      {
        "description": "Gomod major — MintMaker opens PR; batch Mon-Fri 9am-5pm EST - manual /lgtm after CI (no lgtm/approved here)",
        "matchUpdateTypes": [
          "major"
        ],
        "automerge": false,
        "schedule": ["* 9-16 * * 1-5"],
        "addLabels": [
          "major-update",
          "manual-review-required",
          "area/dependency",
          "ok-to-test"
        ]
      }
    ]
  },
  "timezone": "America/New_York",
  "updateNotScheduled": false,
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "rebaseLabel": "needs-rebase"
}
