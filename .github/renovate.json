{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>konflux-ci/mintmaker//config/renovate/renovate.json",
    "config:best-practices",
    ":automergeDigest",
    "group:allDigest"
  ],
  "enabledManagers": [
    "dockerfile",
    "tekton",
    "gomod"
  ],
  "dockerfile": {
    "includePaths": [
      "config/Dockerfile"
    ],
    "packageRules": [
      {
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest"
        ],
        "automerge": false,
        "platformAutomerge": false,
        "addLabels": ["lgtm", "approved"]
      }
    ]
  },
  "tekton": {
    "includePaths": [
      "pipelines/**",
      ".tekton/**"
    ],
    "enabled": true,
    "packageRules": [
      {
        "description": "Tekton patch/minor; batch Mon-Fri 9am-5pm EST — pre-label lgtm/approved; Tide merges after Prow + Konflux",
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest"
        ],
        "automerge": false,
        "schedule": ["* 9-16 * * 1-5"],
        "platformAutomerge": false,
        "addLabels": ["lgtm", "approved"]
      },
      {
        "description": "Tekton major — open PR for manual /lgtm; never automerge",
        "matchUpdateTypes": [
          "major"
        ],
        "automerge": false,
        "addLabels": [
          "major-update",
          "manual-review-required",
          "area/dependency",
          "ok-to-test"
        ]
      }
    ]
  },
  "gomod": {
    "packageRules": [
      {
        "description": "Grouped gomod minor/patch; batch Mon-Fri 9am-5pm EST — pre-label lgtm/approved; Tide merges after Prow + Konflux",
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest"
        ],
        "groupName": "gomod dependencies",
        "schedule": ["* 9-16 * * 1-5"],
        "automerge": false,
        "platformAutomerge": false,
        "addLabels": ["lgtm", "approved"]
      },
      {
        "description": "Gomod major — MintMaker opens PR; batch Mon-Fri 9am-5pm EST - manual /lgtm after CI (no lgtm/approved here)",
        "matchUpdateTypes": [
          "major"
        ],
        "automerge": false,
        "schedule": ["* 9-16 * * 1-5"],
        "addLabels": [
          "major-update",
          "manual-review-required",
          "area/dependency",
          "ok-to-test"
        ]
      },
      {
        "description": "Disable major updates for indirect gomod dependencies. MintMaker enables indirect deps and runs gomodUpdateImportPaths, but that can only rewrite import paths in this repo's own source. A major bump of a purely transitive dependency changes it to a module path (e.g. /v2 -> /v3) that only an upstream consumer imports, so nothing in the graph uses the new path, go.sum can't be reconciled, and gomodTidy reverts the change - the PR can never go green. These update naturally when the parent dependency adopts the new major.",
        "matchUpdateTypes": [
          "major"
        ],
        "matchDepTypes": [
          "indirect"
        ],
        "enabled": false
      }
    ]
  },
  "timezone": "America/New_York",
  "updateNotScheduled": false,
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "rebaseLabel": "needs-rebase"
}
